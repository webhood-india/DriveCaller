<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="@color/dc_background"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INCOMING CALL"
        android:textColor="@color/dc_muted"
        android:textSize="13sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/callerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Unknown"
        android:textColor="@color/dc_text"
        android:textSize="34sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/callerNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/dc_muted"
        android:textSize="16sp"/>

    <TextView
        android:id="@+id/voiceHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:text="Say “Accept” to answer or “Reject” to decline."
        android:textColor="@color/dc_muted"
        android:textSize="15sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/rejectButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_danger_button"
            android:text="Decline"
            android:textAllCaps="false"
            android:textColor="@color/dc_text"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/answerButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_success_button"
            android:text="Answer"
            android:textAllCaps="false"
            android:textColor="@color/dc_text"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
