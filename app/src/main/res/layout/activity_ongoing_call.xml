<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="@color/dc_background"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ONGOING CALL"
        android:textColor="@color/dc_muted"
        android:textSize="13sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/ongoingName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Caller"
        android:textColor="@color/dc_text"
        android:textSize="34sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/ongoingNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/dc_muted"
        android:textSize="16sp"/>

    <TextView
        android:id="@+id/callTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:gravity="center"
        android:text="00:00"
        android:textColor="@color/dc_accent"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/endCallButton"
        android:layout_width="220dp"
        android:layout_height="58dp"
        android:layout_marginTop="38dp"
        android:background="@drawable/bg_danger_button"
        android:text="End call"
        android:textAllCaps="false"
        android:textColor="@color/dc_text"
        android:textSize="16sp"
        android:textStyle="bold"/>
</LinearLayout>
